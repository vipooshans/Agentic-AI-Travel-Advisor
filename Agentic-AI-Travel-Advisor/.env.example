# Copy to .env and replace every placeholder. .env is git-ignored.
POSTGRES_PASSWORD=change-me-strong-password
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Seeds admin/owner/agent demo accounts (set false outside demos).
SEED_DEMO_USERS=true

# Optional: add LAN origins in docker-compose if a browser on another device
# talks to the API (Flutter APK does not need CORS).
# Example: Cors__AllowedOrigins__3=http://192.168.1.10:7000
