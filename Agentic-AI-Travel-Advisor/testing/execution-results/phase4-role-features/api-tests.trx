info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT r."Id", r."Capacity", r."CreatedAt", r."HotelId", r."IsAvailable", r."Name", r."PricePerNight", r."RoomType", r."UpdatedAt", h."Id"&#xD;
      FROM "Hotels" AS h&#xD;
      INNER JOIN "Rooms" AS r ON h."Id" = r."HotelId"&#xD;
      WHERE h."ApprovalStatus" = 1&#xD;
      ORDER BY h."Name", h."Id"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (2ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT t."Id", t."BookingId", t."Comment", t."CreatedAt", t."HotelId", t."Rating", t."Status", t."TravelPackageId", t."UpdatedAt", t."UserId", h."Id"&#xD;
      FROM "Hotels" AS h&#xD;
      INNER JOIN (&#xD;
          SELECT r."Id", r."BookingId", r."Comment", r."CreatedAt", r."HotelId", r."Rating", r."Status", r."TravelPackageId", r."UpdatedAt", r."UserId"&#xD;
          FROM "Reviews" AS r&#xD;
          WHERE r."Status" = 0&#xD;
      ) AS t ON h."Id" = t."HotelId"&#xD;
      WHERE h."ApprovalStatus" = 1&#xD;
      ORDER BY h."Name", h."Id"&#xD;
