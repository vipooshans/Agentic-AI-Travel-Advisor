      SELECT r."Id", r."Capacity", r."CreatedAt", r."HotelId", r."IsAvailable", r."Name", r."PricePerNight", r."RoomType", r."UpdatedAt", h."Id"&#xD;
      FROM "Hotels" AS h&#xD;
