          SELECT r."Id", r."BookingId", r."Comment", r."CreatedAt", r."HotelId", r."Rating", r."Status", r."TravelPackageId", r."UpdatedAt", r."UserId"&#xD;
          FROM "Reviews" AS r&#xD;
          WHERE r."Status" = 0&#xD;
