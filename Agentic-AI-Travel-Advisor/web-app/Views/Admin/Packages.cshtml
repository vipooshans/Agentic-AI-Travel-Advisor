@using TravelAdvisor.Core.Enums
@model List<TravelAdvisor.Core.DTOs.Packages.TravelPackageDto>
@{
    Layout = "_AdminLayout";
    var filter = ViewBag.ApprovalFilter as ApprovalStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Packages</h5>
</div>
<div class="mb-3">
    <a asp-action="Packages" class="btn btn-sm @(!filter.HasValue ? "btn-secondary" : "btn-outline-secondary")">All</a>
    <a asp-action="Packages" asp-route-approvalStatus="@((int)ApprovalStatus.Pending)" class="btn btn-sm @(filter == ApprovalStatus.Pending ? "btn-secondary" : "btn-outline-secondary")">Pending</a>
    <a asp-action="Packages" asp-route-approvalStatus="@((int)ApprovalStatus.Approved)" class="btn btn-sm @(filter == ApprovalStatus.Approved ? "btn-secondary" : "btn-outline-secondary")">Approved</a>
    <a asp-action="Packages" asp-route-approvalStatus="@((int)ApprovalStatus.Rejected)" class="btn btn-sm @(filter == ApprovalStatus.Rejected ? "btn-secondary" : "btn-outline-secondary")">Rejected</a>
</div>
@if (!Model.Any())
{
    ViewData["EmptyTitle"] = "No packages found";
    ViewData["EmptyMessage"] = "No packages match this approval filter.";
    @await Html.PartialAsync("_EmptyState")
}
else
{
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th>Title</th><th>Destination</th><th>Duration</th><th>Price</th><th>Approval</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.ApprovalStatus == ApprovalStatus.Pending ? "table-warning" : null)">
            <td>@p.Title</td><td>@p.DestinationName</td><td>@p.DurationDays days</td><td>$@p.Price</td>
            <td>@await Html.PartialAsync("_ApprovalBadge", p.ApprovalStatus)</td>
            <td>
                @if (p.ApprovalStatus != ApprovalStatus.Approved)
                {
                    <form asp-action="SetPackageApproval" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="status" value="@((int)ApprovalStatus.Approved)" />
                        <button class="btn btn-sm btn-success">Approve</button>
                    </form>
                }
                @if (p.ApprovalStatus != ApprovalStatus.Rejected)
                {
                    <form asp-action="SetPackageApproval" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="status" value="@((int)ApprovalStatus.Rejected)" />
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
}
