@using TravelAdvisor.Core.Enums
@model List<TravelAdvisor.Core.DTOs.Hotels.HotelDto>
@{
    Layout = "_AdminLayout";
    var filter = ViewBag.ApprovalFilter as ApprovalStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Hotels</h5>
</div>
<div class="mb-3">
    <a asp-action="Hotels" class="btn btn-sm @(!filter.HasValue ? "btn-secondary" : "btn-outline-secondary")">All</a>
    <a asp-action="Hotels" asp-route-approvalStatus="@((int)ApprovalStatus.Pending)" class="btn btn-sm @(filter == ApprovalStatus.Pending ? "btn-secondary" : "btn-outline-secondary")">Pending</a>
    <a asp-action="Hotels" asp-route-approvalStatus="@((int)ApprovalStatus.Approved)" class="btn btn-sm @(filter == ApprovalStatus.Approved ? "btn-secondary" : "btn-outline-secondary")">Approved</a>
    <a asp-action="Hotels" asp-route-approvalStatus="@((int)ApprovalStatus.Rejected)" class="btn btn-sm @(filter == ApprovalStatus.Rejected ? "btn-secondary" : "btn-outline-secondary")">Rejected</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>City</th><th>Country</th><th>Rooms</th><th>Approval</th><th></th></tr></thead>
    <tbody>
    @foreach (var h in Model)
    {
        <tr class="@(h.ApprovalStatus == ApprovalStatus.Pending ? "table-warning" : null)">
            <td>@h.Name</td><td>@h.City</td><td>@h.Country</td><td>@h.RoomCount</td>
            <td>@await Html.PartialAsync("_ApprovalBadge", h.ApprovalStatus)</td>
            <td>
                @if (h.ApprovalStatus != ApprovalStatus.Approved)
                {
                    <form asp-action="SetHotelApproval" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@h.Id" />
                        <input type="hidden" name="status" value="@((int)ApprovalStatus.Approved)" />
                        <button class="btn btn-sm btn-success">Approve</button>
                    </form>
                }
                @if (h.ApprovalStatus != ApprovalStatus.Rejected)
                {
                    <form asp-action="SetHotelApproval" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@h.Id" />
                        <input type="hidden" name="status" value="@((int)ApprovalStatus.Rejected)" />
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
