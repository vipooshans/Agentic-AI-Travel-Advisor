        <div class="stat-card">
            <h6>Total Users</h6>
            <p class="stat-value">—</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <h6>Active Bookings</h6>
            <p class="stat-value">—</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
