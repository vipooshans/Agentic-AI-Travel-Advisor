@model TravelAdvisor.Core.DTOs.Reports.ReportSummaryDto?
@{ Layout = "_AdminLayout"; }

<div class="row g-4">
    <div class="col-md-3"><div class="stat-card"><h6>Total Users</h6><p class="stat-value">@(Model?.UserCount ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Hotel Owners</h6><p class="stat-value">@(Model?.HotelOwnerCount ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Travel Agents</h6><p class="stat-value">@(Model?.TravelAgentCount ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card stat-card-accent"><h6>Revenue</h6><p class="stat-value">$@((Model?.Revenue ?? 0).ToString("N0"))</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Hotels</h6><p class="stat-value">@(Model?.HotelCount ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Packages</h6><p class="stat-value">@(Model?.PackageCount ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Hotel approvals pending</h6><p class="stat-value">@(Model?.PendingHotelApprovals ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Package approvals pending</h6><p class="stat-value">@(Model?.PendingPackageApprovals ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Pending bookings</h6><p class="stat-value">@(Model?.PendingBookings ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Confirmed</h6><p class="stat-value">@(Model?.ConfirmedBookings ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Completed</h6><p class="stat-value">@(Model?.CompletedBookings ?? 0)</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Cancelled</h6><p class="stat-value">@(Model?.CancelledBookings ?? 0)</p></div></div>
</div>

<section class="insight-card">
    <div>
        <p class="eyebrow">Reports</p>
        <h2>How the house is moving</h2>
        <p>Live counts from the API. Revenue is the sum of confirmed and completed booking totals. Traveler accounts stay on the mobile app; create owners and agents from Users.</p>
    </div>
    <div class="insight-actions">
        <a asp-action="Users" class="btn btn-primary">People</a>
        <a asp-action="Bookings" class="btn btn-outline-primary">Bookings</a>
    </div>
</section>
