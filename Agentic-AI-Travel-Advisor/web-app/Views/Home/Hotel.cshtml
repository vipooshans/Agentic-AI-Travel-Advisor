@using TravelAdvisor.Core.DTOs.Hotels
@model HotelDetailDto
@{
    ViewData["Title"] = Model.Name;
    var rooms = ViewBag.Rooms as List<RoomDto> ?? new();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-muted">&larr; Back to all stays</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-4 align-items-center">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="col-md-5">
                    <img src="@Model.ImageUrl" class="img-fluid rounded-3 w-100" style="max-height: 300px; object-fit: cover;" alt="@Model.Name" />
                </div>
            }
            <div class="@(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? "col-md-7" : "col-12")">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="fw-bold mb-0">@Model.Name</h2>
                    @if (Model.AverageRating.HasValue)
                    {
                        <span class="badge bg-warning text-dark fs-6">&#9733; @Model.AverageRating.Value.ToString("0.0")</span>
                    }
                </div>
                <p class="text-muted mb-2">@Model.Address, @Model.City, @Model.Country</p>
                <p class="text-secondary">@Model.Description</p>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3">Available Rooms</h4>

    @if (rooms.Count == 0)
    {
        <div class="card p-4 text-center border-0 shadow-sm rounded-3">
            <p class="text-muted mb-0">No rooms are currently listed for this hotel.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in rooms)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">@r.Name</h5>
                                <span class="badge @(r.IsAvailable ? "bg-success" : "bg-secondary")">
                                    @(r.IsAvailable ? "Available" : "Unavailable")
                                </span>
                            </div>
                            <p class="text-muted small mb-2">Capacity: @r.Capacity guests</p>
                            <p class="text-secondary small mb-3">@r.RoomType</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div>
                                <span class="fs-5 fw-bold text-primary">LKR @r.PricePerNight.ToString("N0")</span>
                                <small class="text-muted">/ night</small>
                            </div>
                            @if (r.IsAvailable)
                            {
                                <a asp-controller="Customer" asp-action="BookHotel" asp-route-hotelId="@Model.Id" asp-route-roomId="@r.Id" class="btn btn-primary px-3">
                                    Book Room
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
