@using TravelAdvisor.Core.DTOs.Destinations
@model List<DestinationDto>
@{
    ViewData["Title"] = "Destinations";
}

<div class="container py-4">
    <div class="mb-4 text-center py-3">
        <h2 class="display-6 fw-bold mb-2">Explore Sri Lankan Destinations</h2>
        <p class="text-muted">From misty tea hills in Nuwara Eliya to golden beaches in Mirissa and ancient fortresses in Sigiriya.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card p-5 text-center border-0 shadow-sm rounded-4">
            <p class="text-muted mb-0">No destinations are currently listed.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var d in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 d-flex flex-column">
                        <span class="badge bg-primary-subtle text-primary mb-2 align-self-start">@d.Country</span>
                        <h4 class="fw-bold mb-2">@d.Name</h4>
                        <p class="text-secondary small mb-4 flex-grow-1">@d.Description</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <a asp-action="Index" asp-route-tab="hotels" asp-route-q="@d.Name" class="btn btn-outline-primary btn-sm px-3">Find Stays</a>
                            <a asp-action="Index" asp-route-tab="packages" asp-route-q="@d.Name" class="btn btn-outline-secondary btn-sm px-3">Find Tours</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
