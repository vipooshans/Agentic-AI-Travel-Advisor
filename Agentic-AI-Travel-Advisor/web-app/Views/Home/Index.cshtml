@using TravelAdvisor.Core.DTOs.Destinations
@using TravelAdvisor.Core.DTOs.Hotels
@using TravelAdvisor.Core.DTOs.Packages
@{
    ViewData["Title"] = "Discover Extraordinary Journeys";
    var destinations = ViewBag.Destinations as List<DestinationDto> ?? new();
    var hotels = ViewBag.Hotels as List<HotelDto> ?? new();
    var packages = ViewBag.Packages as List<TravelPackageDto> ?? new();
    var tab = ViewBag.ActiveTab as string ?? "hotels";

    string GetDestinationImage(string name)
    {
        var lower = (name ?? "").ToLowerInvariant();
        if (lower.Contains("ella")) return "https://images.unsplash.com/photo-1546708973-b339540b5162?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("galle")) return "https://images.unsplash.com/photo-1588598198321-9735fd52455b?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("kandy")) return "https://images.unsplash.com/photo-1586500036706-41963de24d8b?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("sigiriya")) return "https://images.unsplash.com/photo-1586861635167-e5223aadc9fe?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("mirissa")) return "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("bali")) return "https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=800&q=80";
        if (lower.Contains("colombo")) return "https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80";
        return "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=800&q=80";
    }
}

<!-- Hero Section -->
<section class="home-hero">
    <div class="container">
        <span class="hero-pill-badge">✦ Handcrafted Sri Lanka Travel</span>
        <h1 class="hero-title">Explore Sri Lanka &amp; Beyond</h1>
        <p class="hero-subtitle">Curated boutique stays, scenic mountain villas, and unforgettable island tour packages.</p>
    </div>
</section>

<!-- Floating Search Bar -->
<div class="hero-search-container">
    <div class="hero-search-card">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <input type="hidden" name="tab" value="@tab" />
            <div class="col-lg-4 col-md-6 search-field-group">
                <label>Search Keyword</label>
                <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Destination, hotel, or tour..." />
            </div>
            <div class="col-lg-3 col-md-6 search-field-group">
                <label>City / Region</label>
                <input type="text" name="city" value="@ViewBag.City" class="form-control" placeholder="e.g. Ella, Kandy, Galle..." />
            </div>
            <div class="col-lg-3 col-md-6 search-field-group">
                <label>Max Budget (LKR)</label>
                <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" placeholder="e.g. 50,000" />
            </div>
            <div class="col-lg-2 col-md-6">
                <button type="submit" class="btn-hero-search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <span>Search</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Featured Destinations Section -->
<div class="container" style="margin-top: 5rem;">
    <div class="d-flex justify-content-between align-items-end section-header">
        <div>
            <h2>Featured Destinations</h2>
            <p>Discover island highlights and cultural sanctuaries across Sri Lanka.</p>
        </div>
        <a asp-action="Destinations" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
            View all destinations &rarr;
        </a>
    </div>

    <div class="row g-4">
        @foreach (var d in destinations.Take(4))
        {
            <div class="col-md-6 col-lg-3">
                <a asp-action="Index" asp-route-q="@d.Name" class="dest-card">
                    <img src="@GetDestinationImage(d.Name)" class="dest-card-bg" alt="@d.Name" />
                    <div class="dest-card-overlay"></div>
                    <div class="dest-card-content">
                        <span class="dest-card-country">@d.Country</span>
                        <h4 class="dest-card-title">@d.Name</h4>
                        <p class="dest-card-desc">@d.Description</p>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Catalog Section (Hotels & Tour Packages) -->
<div class="container" style="margin-top: 5rem; margin-bottom: 3rem;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center section-header gap-3">
        <div>
            <h2>Curated Travel Catalog</h2>
            <p>Verified boutique accommodations and guided multi-day itineraries.</p>
        </div>
        <div class="catalog-tabs">
            <a class="catalog-tab-btn @(tab == "hotels" ? "active" : "")" asp-action="Index" asp-route-tab="hotels" asp-route-q="@ViewBag.Query" asp-route-city="@ViewBag.City" asp-route-maxPrice="@ViewBag.MaxPrice">
                Hotels &amp; Stays (@hotels.Count)
            </a>
            <a class="catalog-tab-btn @(tab == "packages" ? "active" : "")" asp-action="Index" asp-route-tab="packages" asp-route-q="@ViewBag.Query" asp-route-city="@ViewBag.City" asp-route-maxPrice="@ViewBag.MaxPrice">
                Tour Packages (@packages.Count)
            </a>
        </div>
    </div>

    @if (tab == "hotels")
    {
        @if (hotels.Count == 0)
        {
            <div class="card p-5 text-center border-0 rounded-4 shadow-sm">
                <h5 class="fw-bold mb-2">No hotels found</h5>
                <p class="text-muted mb-0">No approved hotels match your search filter. Try clearing your search parameters.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var h in hotels)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="item-card">
                            <div class="item-card-media">
                                @if (!string.IsNullOrWhiteSpace(h.ImageUrl))
                                {
                                    <img src="@h.ImageUrl" alt="@h.Name" />
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80" alt="@h.Name" />
                                }

                                @if (h.AverageRating.HasValue)
                                {
                                    <span class="item-badge-floating">
                                        ★ @h.AverageRating.Value.ToString("0.0")
                                    </span>
                                }
                            </div>
                            <div class="item-card-body">
                                <h3 class="item-card-title">@h.Name</h3>
                                <div class="item-card-meta">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <span>@h.City, @h.Country</span>
                                </div>
                                <p class="item-card-desc">@h.Description</p>
                                <div class="item-card-footer">
                                    <div>
                                        <span class="price-sub">From</span>
                                        <span class="price-main">LKR @(h.MinPricePerNight.HasValue ? h.MinPricePerNight.Value.ToString("N0") : "Contact for rates")</span>
                                        @if (h.MinPricePerNight.HasValue)
                                        {
                                            <small class="text-muted">/ night</small>
                                        }
                                    </div>
                                    <a asp-action="Hotel" asp-route-id="@h.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">
                                        View Rooms
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (packages.Count == 0)
        {
            <div class="card p-5 text-center border-0 rounded-4 shadow-sm">
                <h5 class="fw-bold mb-2">No tour packages found</h5>
                <p class="text-muted mb-0">No approved tour packages match your search filter. Try clearing your search parameters.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in packages)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="item-card">
                            <div class="item-card-media">
                                @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Title" />
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=800&q=80" alt="@p.Title" />
                                }
                                <span class="item-badge-floating">
                                    @p.DurationDays Days Tour
                                </span>
                            </div>
                            <div class="item-card-body">
                                <h3 class="item-card-title">@p.Title</h3>
                                <div class="item-card-meta">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    <span>Max @p.MaxTravelers travelers</span>
                                </div>
                                <p class="item-card-desc">@p.Description</p>
                                <div class="item-card-footer">
                                    <div>
                                        <span class="price-sub">Total Price</span>
                                        <span class="price-main">LKR @p.Price.ToString("N0")</span>
                                    </div>
                                    <a asp-action="Package" asp-route-id="@p.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">
                                        View Tour
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
