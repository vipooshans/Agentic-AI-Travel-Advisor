@using TravelAdvisor.Core.DTOs.Hotels
@model HotelDetailDto
@{
    Layout = "_AdminLayout";
    var rooms = ViewBag.Rooms as List<RoomDto> ?? new();
}

<div class="mb-4">
    <a asp-action="Hotels" class="text-decoration-none small text-muted">&larr; Back to all hotels</a>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="row g-4 align-items-center">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-3 w-100" style="max-height: 280px; object-fit: cover;" alt="@Model.Name" />
            </div>
        }
        <div class="@(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? "col-md-7" : "col-12")">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="fw-bold mb-0">@Model.Name</h3>
                @if (Model.Rating.HasValue)
                {
                    <span class="badge bg-warning text-dark fs-6">&#9733; @Model.Rating.Value.ToString("0.0")</span>
                }
            </div>
            <p class="text-muted mb-2">@Model.Address, @Model.City, @Model.Country</p>
            <p class="text-secondary">@Model.Description</p>
            @if (!string.IsNullOrWhiteSpace(Model.Amenities))
            {
                <div class="mt-3">
                    <span class="small fw-semibold text-muted d-block mb-1">Amenities:</span>
                    @foreach (var amenity in Model.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1">@amenity</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<h5 class="fw-bold mb-3">Available Rooms</h5>

@if (rooms.Count == 0)
{
    <div class="card p-4 text-center border-0 shadow-sm rounded-3">
        <p class="text-muted mb-0">No rooms are currently listed for this hotel.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in rooms)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold mb-0">@r.Name</h6>
                            <span class="badge @(r.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(r.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </div>
                        <p class="text-muted small mb-2">Capacity: @r.Capacity guests</p>
                        @if (!string.IsNullOrWhiteSpace(r.Description))
                        {
                            <p class="text-secondary small mb-3">@r.Description</p>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <div>
                            <span class="fs-5 fw-bold text-primary">LKR @r.PricePerNight.ToString("N0")</span>
                            <small class="text-muted">/ night</small>
                        </div>
                        @if (r.IsAvailable)
                        {
                            <a asp-action="BookHotel" asp-route-hotelId="@Model.Id" asp-route-roomId="@r.Id" class="btn btn-primary btn-sm px-3">
                                Reserve Room
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Unavailable</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
