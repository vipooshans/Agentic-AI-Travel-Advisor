@using TravelAdvisor.Core.DTOs.Packages
@model List<TravelPackageDto>
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1">Tour Packages</h5>
        <p class="text-muted small mb-0">Handcrafted travel itineraries, guided tours, and multi-day island journeys.</p>
    </div>
    <form method="get" asp-action="Packages" class="d-flex gap-2" style="max-width: 320px;">
        <input type="text" name="q" value="@ViewBag.SearchQuery" class="form-control form-control-sm" placeholder="Search packages, tours..." />
        <button type="submit" class="btn btn-primary btn-sm px-3">Search</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card p-5 text-center border-0 shadow-sm rounded-4">
        <p class="text-muted mb-0">No approved tour packages match your search query.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@p.Title" />
                    }
                    else
                    {
                        <div class="bg-secondary-subtle d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                            <span>No image</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="card-title fw-bold mb-0">@p.Title</h5>
                            <span class="badge bg-info-subtle text-info">@p.DurationDays Days</span>
                        </div>
                        <p class="text-muted small mb-2">Max party: @p.MaxTravelers travelers</p>
                        <p class="card-text text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @p.Description
                        </p>
                        <hr class="my-3 opacity-25" />
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Price per person</small>
                                <strong class="text-primary">LKR @p.Price.ToString("N0")</strong>
                            </div>
                            <a asp-action="Package" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm px-3">View Tour</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
