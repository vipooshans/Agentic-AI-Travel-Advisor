@using TravelAdvisor.Core.DTOs.Bookings
@using TravelAdvisor.Core.Enums
@model List<BookingDto>
@{
    Layout = "_AdminLayout";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="stat-card">
            <h6>Total Bookings</h6>
            <p class="stat-value">@ViewBag.TotalBookings</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <h6>Pending Confirmation</h6>
            <p class="stat-value">@ViewBag.PendingBookings</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <h6>Confirmed Trips</h6>
            <p class="stat-value">@ViewBag.ConfirmedBookings</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-card-accent">
            <h6>Total Spent</h6>
            <p class="stat-value">LKR @(((decimal)(ViewBag.TotalSpent ?? 0)).ToString("N0"))</p>
        </div>
    </div>
</div>

<section class="insight-card my-4">
    <div>
        <p class="eyebrow">Discover Sri Lanka</p>
        <h2>Ready for your next adventure?</h2>
        <p>Explore hand-picked boutique hotels, beachfront villas, and guided island travel packages across Sri Lanka.</p>
    </div>
    <div class="insight-actions">
        <a asp-action="Hotels" class="btn btn-primary">Explore Hotels</a>
        <a asp-action="Packages" class="btn btn-outline-primary">Tour Packages</a>
    </div>
</section>

<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
    <h5 class="mb-0">Recent Bookings</h5>
    <a asp-action="Bookings" class="btn btn-sm btn-outline-secondary">View all bookings &rarr;</a>
</div>

@if (Model.Count == 0)
{
    <div class="card p-4 text-center border-0 shadow-sm rounded-3">
        <p class="text-muted mb-3">You don't have any reservations yet.</p>
        <div>
            <a asp-action="Hotels" class="btn btn-primary btn-sm me-2">Browse Hotels</a>
            <a asp-action="Packages" class="btn btn-outline-primary btn-sm">Explore Packages</a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Listing</th>
                    <th>Dates</th>
                    <th>Guests</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><strong>#@b.Id</strong></td>
                        <td>@(b.HotelName != null ? $"{b.HotelName} · {b.RoomName}" : b.PackageTitle)</td>
                        <td>@b.CheckIn.ToString("yyyy-MM-dd") &rarr; @b.CheckOut.ToString("yyyy-MM-dd")</td>
                        <td>@b.Guests guest@(b.Guests == 1 ? "" : "s")</td>
                        <td><strong>LKR @b.TotalPrice.ToString("N0")</strong></td>
                        <td>@await Html.PartialAsync("_BookingStatusBadge", b.Status)</td>
                        <td class="text-end">
                            @if (b.Status is BookingStatus.Pending or BookingStatus.Confirmed)
                            {
                                <form asp-action="CancelBooking" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel booking #@b.Id?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
