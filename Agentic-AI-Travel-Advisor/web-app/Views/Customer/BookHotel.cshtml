@using TravelAdvisor.Core.DTOs.Bookings
@using TravelAdvisor.Core.DTOs.Hotels
@model CreateBookingRequest
@{
    Layout = "_AdminLayout";
    var hotel = ViewBag.Hotel as HotelDetailDto;
    var room = ViewBag.Room as RoomDto;
}

<div class="mb-3">
    @if (hotel != null)
    {
        <a asp-action="Hotel" asp-route-id="@hotel.Id" class="btn btn-sm btn-outline-secondary">&larr; Back to @hotel.Name</a>
    }
    else
    {
        <a asp-action="Hotels" class="btn btn-sm btn-outline-secondary">&larr; Back to hotels</a>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <section class="panel-card p-4">
            <h5 class="fw-bold mb-1" >Reserve Your Stay</h5>
            <p class="text-muted small mb-4">Complete the form below to submit your booking request. Bookings start in Pending status until confirmed by the hotel owner.</p>

            <form asp-action="BookHotel" asp-route-hotelId="@(hotel?.Id ?? 0)" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoomId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CheckIn" class="form-label small fw-semibold">Check-in Date</label>
                        <input asp-for="CheckIn" type="date" class="form-control" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="CheckIn" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CheckOut" class="form-label small fw-semibold">Check-out Date</label>
                        <input asp-for="CheckOut" type="date" class="form-control" min="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="CheckOut" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Guests" class="form-label small fw-semibold">Number of Guests</label>
                    <input asp-for="Guests" type="number" min="1" max="@(room?.Capacity ?? 10)" class="form-control" />
                    <span class="text-muted small">Maximum room capacity: @(room?.Capacity ?? 2) guests</span>
                    <span asp-validation-for="Guests" class="text-danger small d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-semibold">Special Requests / Notes (Optional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="e.g. late check-in, dietary preferences, extra pillows"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Booking Request</button>
                <a asp-action="Hotels" class="btn btn-link">Cancel</a>
            </form>
        </section>
    </div>

    <div class="col-lg-5">
        <section class="panel-card p-4">
            <h6 class="fw-bold mb-3">Stay Summary</h6>
            @if (hotel != null && room != null)
            {
                <div class="mb-3">
                    <h5 class="fw-bold mb-1 text-primary">@hotel.Name</h5>
                    <p class="text-muted small mb-2">@hotel.City, @hotel.Country</p>
                    <div class="border-top pt-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Selected Room:</span>
                            <span class="fw-semibold">@room.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Nightly Rate:</span>
                            <span class="fw-semibold">LKR @room.PricePerNight.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Max Capacity:</span>
                            <span class="fw-semibold">@room.Capacity guests</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border small text-muted mb-0">
                    Your booking will be reviewed and confirmed by the hotel. No charges are incurred immediately.
                </div>
            }
        </section>
    </div>
</div>
