@using TravelAdvisor.Core.DTOs.Destinations
@model List<DestinationDto>
@{
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <p class="text-muted mb-0">Explore breathtaking cultural, coastal, and hill-country destinations across Sri Lanka.</p>
</div>

@if (!Model.Any())
{
    ViewData["EmptyTitle"] = "No destinations listed";
    ViewData["EmptyMessage"] = "No destinations are currently available.";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="row g-3">
        @foreach (var d in Model)
        {
            <div class="col-md-6 col-lg-4">
                <section class="panel-card h-100 p-4 d-flex flex-column">
                    <span class="badge bg-primary-subtle text-primary mb-2 align-self-start">@d.Country</span>
                    <h5 class="fw-bold mb-2">@d.Name</h5>
                    <p class="text-secondary small mb-3 flex-grow-1">@d.Description</p>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                        <a asp-action="Hotels" asp-route-q="@d.Name" class="btn btn-outline-primary btn-sm">Find Stays</a>
                        <a asp-action="Packages" asp-route-q="@d.Name" class="btn btn-outline-secondary btn-sm">Find Tours</a>
                    </div>
                </section>
            </div>
        }
    </div>
}
