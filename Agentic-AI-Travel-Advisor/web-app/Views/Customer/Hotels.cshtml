@using TravelAdvisor.Core.DTOs.Hotels
@model List<HotelDto>
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Browse approved hotels, hillside villas, and beach resorts across Sri Lanka.</p>
    <form method="get" asp-action="Hotels" class="d-flex gap-2" style="max-width: 320px;">
        <input type="text" name="q" value="@ViewBag.SearchQuery" class="form-control form-control-sm" placeholder="Search hotels, city..." />
        <button type="submit" class="btn btn-primary btn-sm px-3">Search</button>
    </form>
</div>

@if (!Model.Any())
{
    ViewData["EmptyTitle"] = "No hotels found";
    ViewData["EmptyMessage"] = "No approved hotels match your search query. Try searching for a different keyword or city.";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="row g-3">
        @foreach (var h in Model)
        {
            <div class="col-md-6 col-lg-4">
                <section class="panel-card h-100 d-flex flex-column p-0 overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(h.ImageUrl))
                    {
                        <img src="@h.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@h.Name" />
                    }
                    else
                    {
                        <div class="bg-secondary-subtle d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                            <span>No image</span>
                        </div>
                    }
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="fw-bold mb-0">@h.Name</h5>
                            @if (h.AverageRating.HasValue)
                            {
                                <span class="badge bg-warning text-dark">&#9733; @h.AverageRating.Value.ToString("0.0")</span>
                            }
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @h.City, @h.Country</p>
                        <p class="text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @h.Description
                        </p>
                        <hr class="my-3 opacity-25" />
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <div>
                                <small class="text-muted d-block">Starting from</small>
                                @if (h.MinPricePerNight.HasValue)
                                {
                                    <strong class="text-primary">LKR @h.MinPricePerNight.Value.ToString("N0")</strong> <span class="small text-muted">/ night</span>
                                }
                                else
                                {
                                    <strong class="text-muted">Price unavailable</strong>
                                }
                            </div>
                            <a asp-action="Hotel" asp-route-id="@h.Id" class="btn btn-outline-primary btn-sm px-3">View Rooms</a>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
}
