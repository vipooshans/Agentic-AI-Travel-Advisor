@using TravelAdvisor.Core.DTOs.Hotels
@model List<HotelDto>
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1">Hotels &amp; Stays</h5>
        <p class="text-muted small mb-0">Browse approved hotels, beach resorts, and hilltop villas across Sri Lanka.</p>
    </div>
    <form method="get" asp-action="Hotels" class="d-flex gap-2" style="max-width: 320px;">
        <input type="text" name="q" value="@ViewBag.SearchQuery" class="form-control form-control-sm" placeholder="Search hotels, city..." />
        <button type="submit" class="btn btn-primary btn-sm px-3">Search</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card p-5 text-center border-0 shadow-sm rounded-4">
        <p class="text-muted mb-0">No approved hotels match your search query.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var h in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(h.ImageUrl))
                    {
                        <img src="@h.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@h.Name" />
                    }
                    else
                    {
                        <div class="bg-secondary-subtle d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                            <span>No image</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="card-title fw-bold mb-0">@h.Name</h5>
                            @if (h.Rating.HasValue)
                            {
                                <span class="badge bg-warning text-dark">&#9733; @h.Rating.Value.ToString("0.0")</span>
                            }
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @h.City, @h.Country</p>
                        <p class="card-text text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @h.Description
                        </p>
                        <hr class="my-3 opacity-25" />
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Starting from</small>
                                <strong class="text-primary">LKR @h.MinPricePerNight.ToString("N0")</strong> <span class="small text-muted">/ night</span>
                            </div>
                            <a asp-action="Hotel" asp-route-id="@h.Id" class="btn btn-outline-primary btn-sm px-3">View Rooms</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
