@using TravelAdvisor.Core.DTOs.Users
@model UserProfileDto
@{
    Layout = "_Layout";
    var displayName = User.Identity?.Name ?? "Traveler";
    var initial = string.IsNullOrWhiteSpace(displayName) ? "U" : char.ToUpperInvariant(displayName.Trim()[0]).ToString();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="panel-card p-4 bg-white rounded-4 shadow-sm border mb-4">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 52px; height: 52px; background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%); font-size: 1.3rem;">
                        @initial
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@displayName</h4>
                        <p class="text-muted small mb-0">Manage your contact details, nationality, and travel preferences.</p>
                    </div>
                </div>

                <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text" id="phoneDialCode">+</span>
                            <input id="phoneNationalNumber"
                                   class="form-control"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="tel-national"
                                   pattern="[0-9]*"
                                   maxlength="15"
                                   placeholder="Select your country first"
                                   aria-describedby="phoneHelp phoneError" />
                        </div>
                        <input asp-for="PhoneNumber" type="hidden" />
                        <div id="phoneHelp" class="form-text">Choose your country to add its calling code. Use digits only.</div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Nationality" class="form-label small fw-semibold">Nationality</label>
                        <select asp-for="Nationality"
                                class="form-select"
                                id="nationalitySelect"
                                data-current-nationality="@Model.Nationality">
                            <option value="">Select your country</option>
                        </select>
                        <span asp-validation-for="Nationality" class="text-danger small"></span>
                    </div>
                </div>
                <div id="phoneError" class="text-danger small mb-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label small fw-semibold">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PreferredCurrency" class="form-label small fw-semibold">Preferred Currency</label>
                        <select asp-for="PreferredCurrency" class="form-select">
                            <option value="LKR">LKR (Sri Lankan Rupee)</option>
                            <option value="USD">USD (US Dollar)</option>
                            <option value="EUR">EUR (Euro)</option>
                            <option value="GBP">GBP (British Pound)</option>
                        </select>
                        <span asp-validation-for="PreferredCurrency" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Bio" class="form-label small fw-semibold">Traveler Bio / Preferences</label>
                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell us a little about your travel style (e.g. nature enthusiast, cultural explorer, luxury stays)..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Profile Changes</button>
            </form>
        </section>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/profile-phone.js" asp-append-version="true"></script>
}
