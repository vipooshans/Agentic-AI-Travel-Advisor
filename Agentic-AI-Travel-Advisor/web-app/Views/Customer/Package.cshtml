@using TravelAdvisor.Core.DTOs.Packages
@model TravelPackageDetailDto
@{
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Packages" class="btn btn-sm btn-outline-secondary">&larr; Back to all tour packages</a>
</div>

<section class="panel-card p-4 mb-4">
    <div class="row g-4 align-items-center">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-3 w-100" style="max-height: 280px; object-fit: cover;" alt="@Model.Title" />
            </div>
        }
        <div class="@(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? "col-md-7" : "col-12")">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="fw-bold mb-0">@Model.Title</h3>
                <span class="badge bg-info-subtle text-info fs-6">@Model.DurationDays Days</span>
            </div>
            <p class="text-muted mb-2">Maximum travelers: @Model.MaxTravelers</p>
            <p class="text-secondary">@Model.Description</p>
            <div class="d-flex align-items-center gap-3 mt-4">
                <div>
                    <small class="text-muted d-block">Base Price</small>
                    <h4 class="text-primary fw-bold mb-0">LKR @Model.Price.ToString("N0")</h4>
                </div>
                <a asp-action="BookPackage" asp-route-packageId="@Model.Id" class="btn btn-primary px-4">
                    Book Tour Package
                </a>
            </div>
        </div>
    </div>
</section>

<p class="section-title">Included Activities</p>

@if (!Model.Activities.Any())
{
    ViewData["EmptyTitle"] = "No activities listed";
    ViewData["EmptyMessage"] = "No specific activities are scheduled for this tour.";
    @await Html.PartialAsync("_EmptyState")
}
else
{
    <div class="row g-3">
        @foreach (var a in Model.Activities)
        {
            <div class="col-md-6">
                <section class="panel-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h6 class="fw-bold mb-0">Day @a.DayNumber: @a.Title</h6>
                        @if (a.Price > 0)
                        {
                            <span class="badge bg-light text-dark border">+ LKR @a.Price.ToString("N0")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.Description))
                    {
                        <p class="text-muted small mb-0">@a.Description</p>
                    }
                </section>
            </div>
        }
    </div>
}
