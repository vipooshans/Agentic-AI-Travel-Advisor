@model BookingProposalReviewViewModel
@{
    ViewData["Title"] = "Review Reservation";
    Layout = "_Layout";
}

<div class="container py-4">
<section class="panel-card bg-white rounded-4 shadow-sm border p-4">
    <div class="panel-head">
        <div>
            <p class="eyebrow">AI Concierge proposal</p>
            <h2 class="mb-1">Review your reservation</h2>
            <p class="text-muted mb-0">Check the stay and account details before submitting your request.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <h3 class="h5">Stay details</h3>
            <dl class="row">
                <dt class="col-sm-4">Hotel / room</dt>
                <dd class="col-sm-8">@Model.ProposalTitle</dd>
                <dt class="col-sm-4">Check-in</dt>
                <dd class="col-sm-8">@Model.CheckIn.ToString("ddd, MMM d, yyyy")</dd>
                <dt class="col-sm-4">Check-out</dt>
                <dd class="col-sm-8">@(Model.CheckOut?.ToString("ddd, MMM d, yyyy") ?? "Not applicable")</dd>
                <dt class="col-sm-4">Guests</dt>
                <dd class="col-sm-8">@Model.Guests</dd>
                <dt class="col-sm-4">Quoted total</dt>
                <dd class="col-sm-8 fw-semibold">LKR @Model.QuotedTotal.ToString("N0")</dd>
            </dl>
        </div>
        <div class="col-lg-5">
            <h3 class="h5">Booking account</h3>
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.CustomerName</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.CustomerEmail</dd>
                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not set in your profile" : Model.PhoneNumber)</dd>
            </dl>
            <p class="small text-muted">The reservation will be created for the account you are currently signed in to.</p>
        </div>
    </div>

    <form asp-action="SubmitProposal" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProposalToken" />
        <input type="hidden" asp-for="ProposalTitle" />
        <input type="hidden" asp-for="QuotedTotal" />
        <input type="hidden" asp-for="RoomId" />
        <input type="hidden" asp-for="TravelPackageId" />
        <input type="hidden" asp-for="CheckIn" />
        <input type="hidden" asp-for="CheckOut" />
        <input type="hidden" asp-for="Guests" />
        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Special requests (optional)</label>
            <textarea asp-for="Notes" class="form-control" maxlength="500" rows="2"></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-between">
            <a asp-action="Dashboard" asp-fragment="bookingAssistant" class="btn btn-outline-secondary">Change details in AI Concierge</a>
            <button type="submit" class="btn btn-success">Confirm reservation request</button>
        </div>
    </form>
</section>
</div>
