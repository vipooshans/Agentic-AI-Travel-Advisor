@{
    var portal = ViewData["Portal"]?.ToString() ?? "Admin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel Advisor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-backdrop"></div>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <h4>Travel Advisor</h4>
                <small>@ViewData["Role"]</small>
            </div>
            <nav class="sidebar-nav">
                @if (portal == "Owner")
                {
                    <a class="@NavClass("Owner", "Dashboard")" asp-controller="Owner" asp-action="Dashboard">Dashboard</a>
                    <a class="@NavClass("Owner", "Hotels")" asp-controller="Owner" asp-action="Hotels">My Hotels</a>
                    <a class="@NavClass("Owner", "CreateHotel")" asp-controller="Owner" asp-action="CreateHotel">Add Hotel</a>
                    <a class="@NavClass("Owner", "Bookings")" asp-controller="Owner" asp-action="Bookings">Bookings</a>
                }
                else if (portal == "Agent")
                {
                    <a class="@NavClass("Agent", "Dashboard")" asp-controller="Agent" asp-action="Dashboard">Dashboard</a>
                    <a class="@NavClass("Agent", "Packages")" asp-controller="Agent" asp-action="Packages">My Packages</a>
                    <a class="@NavClass("Agent", "CreatePackage")" asp-controller="Agent" asp-action="CreatePackage">Create Package</a>
                    <a class="@NavClass("Agent", "Bookings")" asp-controller="Agent" asp-action="Bookings">Bookings</a>
                }
                else
                {
                    <a class="@NavClass("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                    <a class="@NavClass("Admin", "Users")" asp-controller="Admin" asp-action="Users">Users</a>
                    <a class="@NavClass("Admin", "CreateUser")" asp-controller="Admin" asp-action="CreateUser">Create owner / agent</a>
                    <a class="@NavClass("Admin", "Hotels")" asp-controller="Admin" asp-action="Hotels">Hotels</a>
                    <a class="@NavClass("Admin", "Packages")" asp-controller="Admin" asp-action="Packages">Packages</a>
                    <a class="@NavClass("Admin", "Bookings")" asp-controller="Admin" asp-action="Bookings">Bookings</a>
                }
            </nav>
        </aside>
        <div class="admin-main">
            <header class="admin-header">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm d-lg-none" id="sidebarToggle">Menu</button>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                    </form>
                </div>
            </header>
            <main class="admin-content">
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show">@error <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show">@success <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
