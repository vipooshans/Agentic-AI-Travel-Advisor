@using TravelAdvisor.Core.DTOs.Bookings
@using TravelAdvisor.Core.Enums
@model BookingDto
@{
    var controller = (string)ViewData["StatusController"]!;
}

@if (Model.Status == BookingStatus.Pending)
{
    <form asp-controller="@controller" asp-action="UpdateBookingStatus" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="status" value="@((int)BookingStatus.Confirmed)" />
        <button class="btn btn-sm btn-success">Confirm</button>
    </form>
    <form asp-controller="@controller" asp-action="UpdateBookingStatus" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="status" value="@((int)BookingStatus.Cancelled)" />
        <button class="btn btn-sm btn-outline-danger">Cancel</button>
    </form>
}
else if (Model.Status == BookingStatus.Confirmed)
{
    <form asp-controller="@controller" asp-action="UpdateBookingStatus" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="status" value="@((int)BookingStatus.Completed)" />
        <button class="btn btn-sm btn-primary">Complete</button>
    </form>
    <form asp-controller="@controller" asp-action="UpdateBookingStatus" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="status" value="@((int)BookingStatus.Cancelled)" />
        <button class="btn btn-sm btn-outline-danger">Cancel</button>
    </form>
}
