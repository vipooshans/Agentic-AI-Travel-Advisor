@using TravelAdvisor.Core.Enums
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var name = User.Identity?.Name ?? "Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel Advisor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header class="border-bottom bg-white sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light container py-2">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="badge bg-primary me-2 px-2 py-1">TA</span> Travel Advisor
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index" asp-route-tab="hotels">Hotels</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index" asp-route-tab="packages">Packages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Destinations">Destinations</a>
                    </li>
                    @if (isAuthenticated && role == RoleNames.User)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-semibold" asp-controller="Customer" asp-action="Bookings">My Bookings</a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3">Sign in</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">Register</a>
                    }
                    else
                    {
                        @if (role == RoleNames.Admin)
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-dark btn-sm">Admin Portal</a>
                        }
                        else if (role == RoleNames.HotelOwner)
                        {
                            <a asp-controller="Owner" asp-action="Dashboard" class="btn btn-outline-dark btn-sm">Owner Portal</a>
                        }
                        else if (role == RoleNames.TravelAgent)
                        {
                            <a asp-controller="Agent" asp-action="Dashboard" class="btn btn-outline-dark btn-sm">Agent Portal</a>
                        }
                        else if (role == RoleNames.User)
                        {
                            <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-primary btn-sm">My Dashboard</a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mb-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mb-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top py-4 bg-white mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2026 Travel Advisor. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
