@using TravelAdvisor.Core.Enums
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var name = User.Identity?.Name ?? "Account";
    var initial = string.IsNullOrWhiteSpace(name) ? "U" : char.ToUpperInvariant(name.Trim()[0]).ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel Advisor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg public-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">TA</span>
                    <span>Travel Advisor</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-tab="hotels">Hotels &amp; Stays</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-tab="packages">Tour Packages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Destinations">Destinations</a>
                        </li>
                        @if (isAuthenticated && role == RoleNames.User)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold" asp-controller="Customer" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Bookings">My Bookings</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (!isAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-sign-in">Sign in</a>
                            <a asp-controller="Account" asp-action="Register" class="btn-register-pill">Register</a>
                        }
                        else
                        {
                            @if (role == RoleNames.Admin)
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">Admin Portal</a>
                            }
                            else if (role == RoleNames.HotelOwner)
                            {
                                <a asp-controller="Owner" asp-action="Dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">Owner Portal</a>
                            }
                            else if (role == RoleNames.TravelAgent)
                            {
                                <a asp-controller="Agent" asp-action="Dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">Agent Portal</a>
                            }
                            else if (role == RoleNames.User)
                            {
                                <a asp-controller="Customer" asp-action="Profile" class="d-flex align-items-center gap-2 text-decoration-none" title="View My Profile">
                                    <span class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 36px; height: 36px; background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%); font-size: 0.85rem; cursor: pointer; transition: transform 0.15s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                                        @initial
                                    </span>
                                    <span class="d-none d-md-inline fw-semibold text-dark small">@name</span>
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Sign out</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3 mb-0">
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3 mb-0">
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-md-5">
                    <div class="footer-brand">
                        <span class="brand-badge">TA</span>
                        <span>Travel Advisor</span>
                    </div>
                    <p class="small text-muted mb-0" style="max-width: 380px;">
                        Handcrafted Sri Lankan journeys, verified boutique hotels, and seamless bookings for travelers worldwide.
                    </p>
                </div>
                <div class="col-md-6 col-lg-5">
                    <div class="row g-3">
                        <div class="col-6">
                            <h6 class="text-white fw-bold mb-3 small text-uppercase">Explore</h6>
                            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                                <li><a asp-controller="Home" asp-action="Index">Discover Stays</a></li>
                                <li><a asp-controller="Home" asp-action="Index" asp-route-tab="packages">Tour Packages</a></li>
                                <li><a asp-controller="Home" asp-action="Destinations">Destinations</a></li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <h6 class="text-white fw-bold mb-3 small text-uppercase">Account</h6>
                            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                                <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                                <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                                <li><a asp-controller="Customer" asp-action="Bookings">My Bookings</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 Travel Advisor. All rights reserved. Built for modern travel exploration and bookings.
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
