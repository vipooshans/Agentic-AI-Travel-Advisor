@using TravelAdvisor.Core.Enums
@model List<TravelAdvisor.Core.DTOs.Bookings.BookingDto>
@{ Layout = "_AdminLayout"; }

<h5 class="mb-2">Package Bookings</h5>
<p class="text-muted">Highlighted rows are customer requests (Pending). Confirm, cancel, or complete from here.</p>
<table class="table table-striped">
    <thead><tr><th>Guest</th><th>Package</th><th>Check-in</th><th>Check-out</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr class="@(b.Status == BookingStatus.Pending ? "table-warning" : null)">
            <td>@b.UserEmail</td><td>@b.PackageTitle</td>
            <td>@b.CheckIn.ToString("yyyy-MM-dd")</td><td>@b.CheckOut.ToString("yyyy-MM-dd")</td>
            <td>$@b.TotalPrice</td>
            <td>@await Html.PartialAsync("_BookingStatusBadge", b.Status)</td>
            <td>@await Html.PartialAsync("_BookingStatusActions", b)</td>
        </tr>
    }
    </tbody>
</table>
