@{ Layout = "_AdminLayout"; }

<div class="row g-4">
    <div class="col-md-4"><div class="stat-card"><h6>My Packages</h6><p class="stat-value">@ViewBag.PackageCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Destinations</h6><p class="stat-value">@ViewBag.DestinationCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Pending approvals</h6><p class="stat-value">@ViewBag.PendingApprovals</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Pending requests</h6><p class="stat-value">@ViewBag.PendingCount</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Confirmed</h6><p class="stat-value">@ViewBag.ConfirmedCount</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Completed</h6><p class="stat-value">@ViewBag.CompletedCount</p></div></div>
    <div class="col-md-3"><div class="stat-card"><h6>Revenue</h6><p class="stat-value">$@(((decimal)(ViewBag.Revenue ?? 0)).ToString("N0"))</p></div></div>
</div>
<div class="card mt-4"><div class="card-body">
    <h5>Package Management</h5>
    <p class="text-muted">New packages stay hidden from travelers until an admin approves them. Customer requests appear as pending bookings.</p>
    <a asp-action="Packages" class="btn btn-primary">View Packages</a>
    <a asp-action="Bookings" class="btn btn-outline-primary">Customer requests</a>
</div></div>
