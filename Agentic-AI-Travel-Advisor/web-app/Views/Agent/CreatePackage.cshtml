@model TravelAdvisor.Web.Models.PackageFormViewModel
@{ Layout = "_AdminLayout"; var destinations = ViewBag.Destinations as List<TravelAdvisor.Core.DTOs.Destinations.DestinationDto>; }

<form asp-action="CreatePackage" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="DestinationId" class="form-label">Destination</label>
        <select asp-for="DestinationId" class="form-select">
            @foreach (var d in destinations ?? [])
            { <option value="@d.Id">@d.Name, @d.Country</option> }
        </select>
    </div>
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" type="number" step="0.01" /></div>
    <div class="mb-3"><label asp-for="DurationDays" class="form-label"></label><input asp-for="DurationDays" class="form-control" type="number" /></div>
    <button type="submit" class="btn btn-primary">Create Package</button>
</form>
