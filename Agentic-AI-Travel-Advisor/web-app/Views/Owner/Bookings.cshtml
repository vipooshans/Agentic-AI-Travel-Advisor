@using TravelAdvisor.Core.Enums
@model List<TravelAdvisor.Core.DTOs.Bookings.BookingDto>
@{ Layout = "_AdminLayout"; }

<h5 class="mb-2">Hotel Bookings</h5>
<p class="text-muted">Pending rows are booking requests. Confirm, cancel, or complete using the actions.</p>
@if (!Model.Any())
{
    ViewData["EmptyTitle"] = "No booking requests";
    ViewData["EmptyMessage"] = "Room bookings for your hotels will appear here.";
    @await Html.PartialAsync("_EmptyState")
}
else
{
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th>Guest</th><th>Room</th><th>Hotel</th><th>Check-in</th><th>Check-out</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr class="@(b.Status == BookingStatus.Pending ? "table-warning" : null)">
            <td>@b.UserEmail</td><td>@b.RoomName</td><td>@b.HotelName</td>
            <td>@b.CheckIn.ToString("yyyy-MM-dd")</td><td>@b.CheckOut.ToString("yyyy-MM-dd")</td>
            <td>$@b.TotalPrice</td>
            <td>@await Html.PartialAsync("_BookingStatusBadge", b.Status)</td>
            <td>@await Html.PartialAsync("_BookingStatusActions", b)</td>
        </tr>
    }
    </tbody>
</table>
</div>
}
