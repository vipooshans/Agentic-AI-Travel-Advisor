@model TravelAdvisor.Web.Models.RoomFormViewModel
@{ Layout = "_AdminLayout"; }

<form asp-action="AddRoom" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="HotelId" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="RoomType" class="form-label"></label><input asp-for="RoomType" class="form-control" /></div>
    <div class="mb-3"><label asp-for="PricePerNight" class="form-label"></label><input asp-for="PricePerNight" class="form-control" type="number" step="0.01" /></div>
    <div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" type="number" /></div>
    <button type="submit" class="btn btn-primary">Add Room</button>
</form>
