@{ Layout = "_AdminLayout"; }

<div class="row g-4">
    <div class="col-md-4"><div class="stat-card"><h6>My Hotels</h6><p class="stat-value">@ViewBag.HotelCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Total Rooms</h6><p class="stat-value">@ViewBag.RoomCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Bookings</h6><p class="stat-value">@ViewBag.BookingCount</p></div></div>
</div>
<div class="card mt-4"><div class="card-body">
    <h5>Hotel Management</h5>
    <p class="text-muted">Manage your hotels, rooms, and view bookings.</p>
    <a asp-action="Hotels" class="btn btn-primary">View Hotels</a>
</div></div>
