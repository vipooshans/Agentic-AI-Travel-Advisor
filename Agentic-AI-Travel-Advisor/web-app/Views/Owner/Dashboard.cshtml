@{ Layout = "_AdminLayout"; }

<div class="row g-4">
    <div class="col-md-4"><div class="stat-card"><h6>My Hotels</h6><p class="stat-value">@ViewBag.HotelCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Rooms</h6><p class="stat-value">@ViewBag.RoomCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Pending approvals</h6><p class="stat-value">@ViewBag.PendingApprovals</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Pending bookings</h6><p class="stat-value">@ViewBag.PendingCount</p></div></div>
    <div class="col-md-4"><div class="stat-card"><h6>Active bookings</h6><p class="stat-value">@ViewBag.BookingCount</p></div></div>
    <div class="col-md-4"><div class="stat-card stat-card-accent"><h6>Revenue</h6><p class="stat-value">$@(((decimal)(ViewBag.Revenue ?? 0)).ToString("N0"))</p></div></div>
</div>
<section class="insight-card">
    <div>
        <p class="eyebrow">Properties</p>
        <h2>Your hotels, quietly held</h2>
        <p>New hotels stay hidden from travelers until an admin approves them. Revenue includes confirmed and completed room bookings.</p>
    </div>
    <div class="insight-actions">
        <a asp-action="Hotels" class="btn btn-primary">View hotels</a>
        <a asp-action="Bookings" class="btn btn-outline-primary">Requests</a>
    </div>
</section>
