{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Inspect running registration logs",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"-f",
				"Agentic-AI-Travel-Advisor\\docker-compose.yml",
				"--project-directory",
				"Agentic-AI-Travel-Advisor",
				"logs",
				"--tail",
				"120",
				"api",
				"web"
			],
			"isBackground": false,
			"problemMatcher": []
		},
