@{
    Layout = "_AdminLayout";
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="stat-card">
            <h6>My Hotels</h6>
            <p class="stat-value">—</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <h6>Total Rooms</h6>
            <p class="stat-value">—</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <h6>Bookings</h6>
            <p class="stat-value">—</p>
        </div>
